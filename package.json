{
  "name": "searly",
  "version": "0.1.3",
  "description": "Offline Android app for the ThermoMaven G1 meat thermometer, over Bluetooth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoryDotGG/searly.git"
  },
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/instrument-sans": "0.4.2",
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "expo": "58.0.19",
    "expo-clipboard": "58.0.4",
    "expo-crypto": "58.0.7",
    "expo-font": "58.0.10",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.11",
    "expo-status-bar": "58.0.4",
    "fzstd": "0.1.1",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-ble-manager": "12.6.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          ".*"
        ]
      }
    }
  }
}
